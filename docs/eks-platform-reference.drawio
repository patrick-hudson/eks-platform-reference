        <mxCell id="step-4" value="4" style="fontFamily=Helvetica;html=1;rounded=1;fillColor=light-dark(#007CBD,#007CBD);fillStyle=auto;strokeColor=default;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="805" y="835" width="28" height="28" />
        </mxCell>
        <mxCell id="step-5" value="5" style="fontFamily=Helvetica;html=1;rounded=1;fillColor=light-dark(#007CBD,#007CBD);fillStyle=auto;strokeColor=default;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="760" y="1000" width="28" height="28" />
        </mxCell>
        <mxCell id="step-6" value="6" style="fontFamily=Helvetica;html=1;rounded=1;fillColor=light-dark(#007CBD,#007CBD);fillStyle=auto;strokeColor=default;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1210" y="690" width="28" height="28" />
        </mxCell>
        <mxCell id="step-7" value="7" style="fontFamily=Helvetica;html=1;rounded=1;fillColor=light-dark(#007CBD,#007CBD);fillStyle=auto;strokeColor=default;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1510" y="625" width="28" height="28" />
        </mxCell>
        <mxCell id="legend" value="" style="fontFamily=Helvetica;html=1;rounded=1;arcSize=2;fillColor=light-dark(#EDF3FF,#20394A);fillStyle=auto;strokeColor=#A4B9D5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1690" y="25" width="650" height="1275" />
        </mxCell>
        <mxCell id="legend-title" value="How to read this page" style="fontFamily=Helvetica;html=1;text;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=light-dark(#172B3A,#F2F5F7);fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1720" y="55" width="580" height="35" />
        </mxCell>
        <mxCell id="legend-1-badge" value="1" style="fontFamily=Helvetica;html=1;rounded=1;fillColor=light-dark(#007CBD,#007CBD);fillStyle=auto;strokeColor=default;strokeWidth=2;fontColor=#FFFFFF;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1720" y="120" width="40" height="38" />
        </mxCell>
        <mxCell id="legend-1-text" value="&lt;b&gt;Resolve Grafana&lt;/b&gt;&lt;br&gt;The existing hudson.tf zone gets Grafana alias records and ACM validation records. Terraform does not create the hosted zone." style="fontFamily=Helvetica;html=1;text;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=light-dark(#172B3A,#F2F5F7);fontSize=15;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1775" y="120" width="525" height="100" />
        </mxCell>
        <mxCell id="legend-2-badge" value="2" style="fontFamily=Helvetica;html=1;rounded=1;fillColor=light-dark(#007CBD,#007CBD);fillStyle=auto;strokeColor=default;strokeWidth=2;fontColor=#FFFFFF;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1720" y="240" width="40" height="38" />
        </mxCell>
        <mxCell id="legend-2-text" value="&lt;b&gt;Terminate public TLS&lt;/b&gt;&lt;br&gt;Internet clients reach the ALB on HTTPS. HTTP redirects to HTTPS; ACM supplies the certificate." style="fontFamily=Helvetica;html=1;text;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=light-dark(#172B3A,#F2F5F7);fontSize=15;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1775" y="240" width="525" height="100" />
        </mxCell>
        <mxCell id="legend-3-badge" value="3" style="fontFamily=Helvetica;html=1;rounded=1;fillColor=light-dark(#007CBD,#007CBD);fillStyle=auto;strokeColor=default;strokeWidth=2;fontColor=#FFFFFF;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1720" y="360" width="40" height="38" />
        </mxCell>
        <mxCell id="legend-3-text" value="&lt;b&gt;Forward only Grafana&lt;/b&gt;&lt;br&gt;The controller creates the ALB from Ingress. IP targets forward HTTP to Grafana pods in private subnets." style="fontFamily=Helvetica;html=1;text;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=light-dark(#172B3A,#F2F5F7);fontSize=15;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1775" y="360" width="525" height="100" />
        </mxCell>
        <mxCell id="legend-4-badge" value="4" style="fontFamily=Helvetica;html=1;rounded=1;fillColor=light-dark(#007CBD,#007CBD);fillStyle=auto;strokeColor=default;strokeWidth=2;fontColor=#FFFFFF;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1720" y="480" width="40" height="38" />
        </mxCell>
        <mxCell id="legend-4-text" value="&lt;b&gt;Query internal metrics&lt;/b&gt;&lt;br&gt;Grafana queries Prometheus. Prometheus scrapes cluster metrics and has no public ingress." style="fontFamily=Helvetica;html=1;text;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=light-dark(#172B3A,#F2F5F7);fontSize=15;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1775" y="480" width="525" height="100" />
        </mxCell>
        <mxCell id="legend-5-badge" value="5" style="fontFamily=Helvetica;html=1;rounded=1;fillColor=light-dark(#007CBD,#007CBD);fillStyle=auto;strokeColor=default;strokeWidth=2;fontColor=#FFFFFF;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1720" y="600" width="40" height="38" />
        </mxCell>
        <mxCell id="legend-5-text" value="&lt;b&gt;Persist monitoring data&lt;/b&gt;&lt;br&gt;Grafana and Prometheus each have a zonal, encrypted gp3 volume. Monitoring is not replicated." style="fontFamily=Helvetica;html=1;text;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=light-dark(#172B3A,#F2F5F7);fontSize=15;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1775" y="600" width="525" height="100" />
        </mxCell>
        <mxCell id="legend-6-badge" value="6" style="fontFamily=Helvetica;html=1;rounded=1;fillColor=light-dark(#007CBD,#007CBD);fillStyle=auto;strokeColor=default;strokeWidth=2;fontColor=#FFFFFF;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1720" y="720" width="40" height="38" />
        </mxCell>
        <mxCell id="legend-6-text" value="&lt;b&gt;Reach images and APIs&lt;/b&gt;&lt;br&gt;Private nodes use NAT and the VPC internet gateway. Dev shares one NAT; prod has one per zone." style="fontFamily=Helvetica;html=1;text;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=light-dark(#172B3A,#F2F5F7);fontSize=15;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1775" y="720" width="525" height="100" />
        </mxCell>
        <mxCell id="legend-7-badge" value="7" style="fontFamily=Helvetica;html=1;rounded=1;fillColor=light-dark(#007CBD,#007CBD);fillStyle=auto;strokeColor=default;strokeWidth=2;fontColor=#FFFFFF;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1720" y="840" width="40" height="38" />
        </mxCell>
        <mxCell id="legend-7-text" value="&lt;b&gt;Run managed Kubernetes&lt;/b&gt;&lt;br&gt;EKS manages the control plane; one managed node group spans private subnets. API access uses configured public CIDRs and a private endpoint." style="fontFamily=Helvetica;html=1;text;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=light-dark(#172B3A,#F2F5F7);fontSize=15;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1775" y="840" width="525" height="100" />
        </mxCell>
        <mxCell id="legend-notes" value="&lt;b&gt;Additional details&lt;/b&gt;&lt;br&gt;Control-plane logs go to CloudWatch. CNI, EBS CSI and the ALB controller use separate IRSA roles.&lt;br&gt;&lt;br&gt;One logical deployment is shown. Dev and prod have separate states and VPCs in the same account.&lt;br&gt;&lt;br&gt;&lt;b&gt;Page 2&lt;/b&gt;&lt;br&gt;Deployment roles, Terraform root order and S3 state paths." style="fontFamily=Helvetica;html=1;text;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=light-dark(#172B3A,#F2F5F7);fontSize=15;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1720" y="980" width="580" height="285" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
