        <mxCell id="legend" value="" style="fontFamily=Helvetica;html=1;rounded=1;arcSize=2;fillColor=light-dark(#EDF3FF,#20394A);fillStyle=auto;strokeColor=#A4B9D5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1620" y="25" width="650" height="1215" />
        </mxCell>
        <mxCell id="legend-title" value="How to read this page" style="fontFamily=Helvetica;html=1;text;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=light-dark(#172B3A,#F2F5F7);fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1650" y="55" width="580" height="35" />
        </mxCell>
        <mxCell id="legend-1-badge" value="1" style="fontFamily=Helvetica;html=1;rounded=1;fillColor=light-dark(#007CBD,#007CBD);fillStyle=auto;strokeColor=default;strokeWidth=2;fontColor=#FFFFFF;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1650" y="120" width="40" height="38" />
        </mxCell>
        <mxCell id="legend-1-text" value="&lt;b&gt;Run checks first&lt;/b&gt;&lt;br&gt;Every PR and main push validates and runs offline tests. Fork PRs receive no AWS session. Merging does not apply." style="fontFamily=Helvetica;html=1;text;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=light-dark(#172B3A,#F2F5F7);fontSize=15;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1705" y="120" width="525" height="100" />
        </mxCell>
        <mxCell id="legend-2-badge" value="2" style="fontFamily=Helvetica;html=1;rounded=1;fillColor=light-dark(#007CBD,#007CBD);fillStyle=auto;strokeColor=default;strokeWidth=2;fontColor=#FFFFFF;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1650" y="240" width="40" height="38" />
        </mxCell>
        <mxCell id="legend-2-text" value="&lt;b&gt;Exchange an OIDC token&lt;/b&gt;&lt;br&gt;Approved same-repository PR plans use dev-plan/prod-plan. Manual applies use dev/prod, with environment protection." style="fontFamily=Helvetica;html=1;text;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=light-dark(#172B3A,#F2F5F7);fontSize=15;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1705" y="240" width="525" height="100" />
        </mxCell>
        <mxCell id="legend-3-badge" value="3" style="fontFamily=Helvetica;html=1;rounded=1;fillColor=light-dark(#007CBD,#007CBD);fillStyle=auto;strokeColor=default;strokeWidth=2;fontColor=#FFFFFF;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1650" y="360" width="40" height="38" />
        </mxCell>
        <mxCell id="legend-3-text" value="&lt;b&gt;Deploy in dependency order&lt;/b&gt;&lt;br&gt;The selected workspace plans the platform before monitoring. A manual apply creates EKS first. A missing cluster defers the read-only monitoring plan." style="fontFamily=Helvetica;html=1;text;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=light-dark(#172B3A,#F2F5F7);fontSize=15;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1705" y="360" width="525" height="100" />
        </mxCell>
        <mxCell id="legend-4-badge" value="4" style="fontFamily=Helvetica;html=1;rounded=1;fillColor=light-dark(#007CBD,#007CBD);fillStyle=auto;strokeColor=default;strokeWidth=2;fontColor=#FFFFFF;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1650" y="480" width="40" height="38" />
        </mxCell>
        <mxCell id="legend-4-text" value="&lt;b&gt;Keep states separate&lt;/b&gt;&lt;br&gt;Each workspace has separate platform and monitoring objects in a shared S3 bucket. Applies use native .tflock objects; read-only plans are unlocked." style="fontFamily=Helvetica;html=1;text;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=light-dark(#172B3A,#F2F5F7);fontSize=15;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1705" y="480" width="525" height="100" />
        </mxCell>
        <mxCell id="legend-5-badge" value="5" style="fontFamily=Helvetica;html=1;rounded=1;fillColor=light-dark(#007CBD,#007CBD);fillStyle=auto;strokeColor=default;strokeWidth=2;fontColor=#FFFFFF;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1650" y="600" width="40" height="38" />
        </mxCell>
        <mxCell id="legend-5-text" value="&lt;b&gt;Connect after EKS exists&lt;/b&gt;&lt;br&gt;The monitoring root discovers EKS through AWS and authenticates with aws eks get-token. It does not read the platform state." style="fontFamily=Helvetica;html=1;text;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=light-dark(#172B3A,#F2F5F7);fontSize=15;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1705" y="600" width="525" height="100" />
        </mxCell>
        <mxCell id="legend-notes" value="&lt;b&gt;Plan feedback&lt;/b&gt;&lt;br&gt;One PR comment per environment is updated with counts, status, commit and workflow link. Raw plan values are not published.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cleanup reverses the order&lt;/b&gt;&lt;br&gt;Destroy monitoring while controllers can remove the ALB and volumes, then destroy the platform and run the AWS audit.&lt;br&gt;&lt;br&gt;&lt;b&gt;Scope&lt;/b&gt;&lt;br&gt;IAM apply roles are privileged. Workspaces separate state; they do not isolate AWS accounts." style="fontFamily=Helvetica;html=1;text;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontColor=light-dark(#172B3A,#F2F5F7);fontSize=15;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1650" y="740" width="580" height="465" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
