  dev = { cluster_name = "eks-platform-reference-dev", deploy_role_name = "github-eks-platform-dev-apply", plan_role_name = "github-eks-platform-dev-plan" }
  prod = { cluster_name = "eks-platform-reference-prod", deploy_role_name = "github-eks-platform-prod-apply", plan_role_name = "github-eks-platform-prod-plan" }
}
domain_name = "hudson.tf"
